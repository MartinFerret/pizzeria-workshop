{
  // The build config, checked with the same settings as the app. Without
  // this file, editors check vite.config.ts with defaults, and import.meta
  // and the plugins' type definitions turn red.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
